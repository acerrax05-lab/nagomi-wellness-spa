async function assignTherapist(bookingId, therapistId) {
  try {
    const res = await fetch(`${apiBase}/bookings/${bookingId}/reassign`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`

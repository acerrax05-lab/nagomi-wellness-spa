function generateCancelledDetail(bookings) {
  const cancelled = bookings.filter(b => b.status === 'cancelled');
  const lostRevenue = cancelled.reduce((sum, b) => sum + (b.price || 0), 0);
  
  const byReason = {};
  cancelled.forEach(b => {
    const reason = b.cancellationReason || 'No reason provided';
    byReason[reason] = (byReason[reason] || 0) + 1;
  });
  
  return `
    <div style="padding: 20px;">
      <div style="padding: 20px; background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); border-radius: 12px; color: white; margin-bottom: 25px;">
        <div style="font-size: 0.95rem; opacity: 0.9;">Total Cancelled Bookings</div>
        <div style="font-size: 2.5rem; font-weight: 700; margin: 10px 0;">${cancelled.length}</div>
        <div style="font-size: 0.9rem; opacity: 0.8;">Potential lost revenue: ₱${lostRevenue.toLocaleString()}</div>
      </div>
      
      ${Object.keys(byReason).length > 0 ? `
        <h5 style="margin-bottom: 15px;">Cancellation Reasons:</h5>
        ${Object.entries(byReason).map(([reason, count]) => `
          <div style="display: flex; justify-content: space-between; padding: 12px; background: #ffebee; margin-bottom: 8px; border-radius: 6px;">
            <span>${reason}</span>
            <span style="font-weight: 600; color: #f44336;">${count} times</span>
          </div>
        `).join('')}
      ` : '<p style="color: #999; text-align: center; padding: 20px;">No cancellation reasons recorded</p>'}
      
      <div style="margin-top: 25px; padding: 15px; background: #fff3e0; border-radius: 8px; border-left: 4px solid #ff9800;">
        <p style="color: #666; margin: 0; line-height: 1.6;">
          <strong>💡 Tip:</strong> High cancellation rates may indicate scheduling issues or service quality concerns. 
          Consider following up with clients for feedback.
        </p>
      </div>
    </div>
  `;
}

function generateTherapistsDetail(bookings) {
  const therapistStats = {};
  
  bookings.forEach(b => {
    if (b.therapist) {
      const id = b.therapist._id || b.therapist;
      const name = b.therapist.name || 'Unknown';
      
      if (!therapistStats[id]) {
        therapistStats[id] = { name, total: 0, completed: 0 };
      }
      
      therapistStats[id].total++;
      if (b.status === 'completed') therapistStats[id].completed++;
    }
  });
  
  const sorted = Object.values(therapistStats).sort((a, b) => b.completed - a.completed);
  
  return `
    <div style="padding: 20px;">
      <h4 style="margin-bottom: 20px;">Active Therapists: ${sorted.length}</h4>
      
      ${sorted.length > 0 ? `
        <canvas id="detailChart" width="400" height="300"></canvas>
        
        <div style="margin-top: 25px;">
          <h5 style="margin-bottom: 15px;">Performance Overview:</h5>
          ${sorted.map((t, index) => `
            <div style="padding: 15px; background: ${index === 0 ? '#fff8e1' : '#f5f5f5'}; margin-bottom: 10px; border-radius: 8px; ${index === 0 ? 'border: 2px solid #ffc107;' : ''}">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 600; font-size: 1.1rem; ${index === 0 ? 'color: #ff9800;' : ''}">${index === 0 ? '🏆 ' : ''}${t.name}</div>
                  <div style="color: #666; font-size: 0.9rem; margin-top: 4px;">
                    ${t.completed} completed / ${t.total} total bookings
                  </div>
                </div>
                <div style="text-align: right;">
                  <div style="font-size: 1.5rem; font-weight: 700; color: #4caf50;">${t.total ? Math.round(t.completed / t.total * 100) : 0}%</div>
                  <div style="font-size: 0.8rem; color: #999;">Success Rate</div>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      ` : '<p style="color: #999; text-align: center; padding: 40px;">No therapist data available for this period</p>'}
    </div>
  `;
}

